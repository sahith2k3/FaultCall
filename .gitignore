# Built application files
*.apk
*.aab
*.ap_
*.dex
*.class

# Allow release APKs in the releases directory
!releases/*.apk

# Gradle files
.gradle/
build/
*/build/

# Local configuration file (sdk.dir, ndk.dir, etc.)
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore

# Google Services / Sensitive API dumps
google-services.json
faultcall_data.xml
*.key
*.pem
.env

# Native builds
.externalNativeBuild/
.cxx/

# Log files
*.log

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# Python (server proxy)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
